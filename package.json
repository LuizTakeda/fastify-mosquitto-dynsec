{
  "name": "fastify-mosquitto-dynsec",
  "version": "1.0.0",
  "description": "Fastify plugin for Mosquitto Dynamic Security (DynSec v1) management",
  "keywords": [
    "fastify",
    "fastify-plugin",
    "mqtt",
    "mosquitto",
    "dynsec",
    "dynamic-security",
    "iot",
    "access-control"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "dev": "tsx --watch example/server.ts",
    "mqtt:start": "docker compose up -d",
    "mqtt:stop": "docker compose down",
    "mqtt:logs": "docker compose logs -f mosquitto",
    "prepublishOnly": "pnpm build"
  },
  "author": "Luiz Takeda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuizTakeda/fastify-mosquitto-dynsec.git"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "fastify-plugin": "^6.0.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "fastify": "^5.12.5"
  }
}